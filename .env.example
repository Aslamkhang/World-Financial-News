# Crypto Intelligence Dashboard - Environment Variables
# Copy this file to .env and fill in the values

# Database (optional - app works without it using mock data)
# For production, use a cloud database like Turso, Neon, or Supabase
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Vercel automatically sets these during build/deployment
# No manual configuration needed for Vercel
